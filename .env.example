# Environment variables for the Next.js Todo application

# Better Auth configuration
AUTH_SECRET=your_auth_secret_here
GITHUB_ID=your_github_client_id
GITHUB_SECRET=your_github_client_secret

# Database configuration (if using a database)
DATABASE_URL=your_database_connection_string

# API endpoints - Railway Backend URL
NEXT_PUBLIC_API_URL=https://taskflow-api-production-46a8.up.railway.app

# Other environment variables as needed
NEXT_PUBLIC_SITE_URL=https://your-vercel-deployment-url.vercel.app